# ---------------------------------------------------------------------------
# CentiCare web app
#
# Copy to .env.local for development; set the same names in Vercel for the
# deployed build. Everything here is compiled into the JavaScript bundle and
# is readable by anyone who opens the site — only ever put public values in
# a VITE_ variable.
#
# The service role key is NOT listed here on purpose. It bypasses row level
# security and belongs only to the backend's own environment.
# ---------------------------------------------------------------------------

# Supabase project. The anon key is public by design; access is controlled by
# row level security and by the sign-in gate, not by hiding this value.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Care plan generator API. Required in production: without it the build
# refuses to start rather than silently calling the visitor's own localhost.
VITE_BACKEND_URL=https://your-backend-host.example.com
